[package]
name = "recasting"
version = "0.2.3"
edition = "2021"
# `flake.nix` and `ci.yml` read this automatically, but run `nix flake update`
# and fix any hashes. The pinned toolchain in `pinned-toolchain.toml` is
# bumped separately.
# REF(msrv_hack) TODO note there are hacks to deal with this low of an MSRV.
rust-version = "1.56"
authors = ["Aaron Kutch <aaronkutch@att.net>"]
license = "MIT OR Apache-2.0"
readme = "README.md"
repository = "https://github.com/AaronKutch/recasting"
documentation = "https://docs.rs/recasting"
description = "traits for one-to-one recasting of values in data structures"
keywords = ["recast", "translate", "no_std"]
categories = ["memory-management", "data-structures", "no-std"]

[features]
default = ["std"]
alloc = []
std = ["alloc"]

[dev-dependencies]
#triple_arena = { path = "../../triple_arena/triple_arena" }
triple_arena = "0.15"
